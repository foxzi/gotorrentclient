[Unit]
Description=GoTorrentClient web daemon
Documentation=https://github.com/piligrim/gotorrentclient
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gotorrentclient
Group=gotorrentclient
ExecStart=/usr/bin/gotorrentclient --web --config /etc/gotorrentclient/config.yaml
Restart=on-failure
RestartSec=5
WorkingDirectory=/var/lib/gotorrentclient

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/gotorrentclient

[Install]
WantedBy=multi-user.target
